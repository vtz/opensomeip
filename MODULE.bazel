"""Bazel module for the host library and its C++ tests."""

module(
    name = "opensomeip",
    version = "0.2.0",
    compatibility_level = 0,
)

# Dev-only so a downstream module that links //:opensomeip does not pull
# GoogleTest into its module graph.
bazel_dep(name = "googletest", version = "1.14.0.bcr.1", dev_dependency = True)
