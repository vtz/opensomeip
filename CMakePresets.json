{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "host-linux",
      "displayName": "Host Linux (POSIX)",
      "description": "Native host build using POSIX threading and BSD sockets",
      "inherits": "base"
    },
    {
      "name": "host-linux-tests",
      "displayName": "Host Linux with Tests",
      "description": "Native host build with unit tests enabled",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "freertos-stub-compile",
      "displayName": "FreeRTOS+lwIP Stub Compile Check",
      "description": "Host-compiler build against FreeRTOS/lwIP stub headers (syntax verification only)",
      "inherits": "base",
      "cacheVariables": {
        "SOMEIP_USE_FREERTOS": "ON",
        "SOMEIP_USE_LWIP": "ON",
        "CMAKE_CXX_FLAGS": "-I${sourceDir}/tests/stubs/freertos -I${sourceDir}/tests/stubs/lwip"
      }
    },
    {
      "name": "freertos-linux-tests",
      "displayName": "FreeRTOS POSIX Port Tests",
      "description": "Runtime tests using FreeRTOS POSIX/Linux port (FetchContent)",
      "inherits": "base",
      "cacheVariables": {
        "SOMEIP_FREERTOS_LINUX_TESTS": "ON"
      }
    },
    {
      "name": "freertos-cortexm4",
      "displayName": "FreeRTOS ARM Cortex-M4",
      "description": "Cross-compile for ARM Cortex-M4 with FreeRTOS and lwIP",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "SOMEIP_USE_FREERTOS": "ON",
        "SOMEIP_USE_LWIP": "ON",
        "ARM_CPU": "cortex-m4",
        "ARM_FPU": "fpv4-sp-d16",
        "ARM_FLOAT_ABI": "hard"
      }
    },
    {
      "name": "threadx-stub-compile",
      "displayName": "ThreadX+lwIP Stub Compile Check",
      "description": "Host-compiler build against ThreadX/lwIP stub headers (syntax verification only)",
      "inherits": "base",
      "cacheVariables": {
        "SOMEIP_USE_THREADX": "ON",
        "SOMEIP_USE_LWIP": "ON",
        "CMAKE_CXX_FLAGS": "-I${sourceDir}/tests/stubs/threadx -I${sourceDir}/tests/stubs/lwip"
      }
    },
    {
      "name": "threadx-linux-tests",
      "displayName": "ThreadX Linux Port Tests",
      "description": "Runtime tests using Eclipse ThreadX Linux port (FetchContent)",
      "inherits": "base",
      "cacheVariables": {
        "SOMEIP_THREADX_LINUX_TESTS": "ON"
      }
    },
    {
      "name": "threadx-cortexm4",
      "displayName": "ThreadX ARM Cortex-M4",
      "description": "Cross-compile for ARM Cortex-M4 with ThreadX and lwIP",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "SOMEIP_USE_THREADX": "ON",
        "SOMEIP_USE_LWIP": "ON",
        "ARM_CPU": "cortex-m4",
        "ARM_FPU": "fpv4-sp-d16",
        "ARM_FLOAT_ABI": "hard"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-linux",
      "configurePreset": "host-linux"
    },
    {
      "name": "host-linux-tests",
      "configurePreset": "host-linux-tests"
    },
    {
      "name": "freertos-stub-compile",
      "configurePreset": "freertos-stub-compile"
    },
    {
      "name": "freertos-linux-tests",
      "configurePreset": "freertos-linux-tests"
    },
    {
      "name": "freertos-cortexm4",
      "configurePreset": "freertos-cortexm4"
    },
    {
      "name": "threadx-stub-compile",
      "configurePreset": "threadx-stub-compile"
    },
    {
      "name": "threadx-linux-tests",
      "configurePreset": "threadx-linux-tests"
    },
    {
      "name": "threadx-cortexm4",
      "configurePreset": "threadx-cortexm4"
    }
  ],
  "testPresets": [
    {
      "name": "host-linux-tests",
      "configurePreset": "host-linux-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30,
        "noTestsAction": "error"
      }
    },
    {
      "name": "freertos-linux-tests",
      "configurePreset": "freertos-linux-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30,
        "noTestsAction": "error"
      }
    },
    {
      "name": "threadx-linux-tests",
      "configurePreset": "threadx-linux-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30,
        "noTestsAction": "error"
      }
    }
  ]
}
