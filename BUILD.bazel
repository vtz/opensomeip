    freertos_sleep_cc_test(
        "test_freertos_sleep_%s_%s" % (bits, rate),
        "tests/test_freertos_sleep_chunks.cpp",
        [
            "configTICK_RATE_HZ=%s" % rate,
            "configUSE_16_BIT_TICKS=%s" % ("1" if bits == "16" else "0"),
